# Enable MPP payment gate for POST /api/shares
MPP_ENABLED=true

# Required
# Long random secret used by mppx to sign/verify payment challenges
MPP_SECRET_KEY=replace-with-a-long-random-secret

# Required
# Recipient address on Tempo chain
MPP_RECIPIENT=0xYourTempoRecipientAddress

# Optional (defaults shown)
MPP_AMOUNT=0.01
MPP_CURRENCY=0x20c0000000000000000000000000000000000000

# Optional: pull or push
MPP_MODE=push

# Optional: true/false
MPP_WAIT_FOR_CONFIRMATION=false
